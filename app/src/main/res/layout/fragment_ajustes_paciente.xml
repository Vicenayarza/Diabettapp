<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".paciente.AjustesPaciente"
    android:background="@color/colorBackground">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="360dp"
        android:layout_height="548dp">

        <ImageView
            android:id="@+id/imageViewvv"
            android:layout_width="62dp"
            android:layout_height="52dp"
            android:src="@drawable/perfil"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.108"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.03" />

        <TextView
            android:id="@+id/ajp"
            android:layout_width="228dp"
            android:layout_height="48dp"
            android:layout_marginEnd="36dp"
            android:fontFamily="@font/pb"
            android:gravity="start"
            android:text="Nombre"
            android:textColor="@color/a1"
            android:textSize="25sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.269"
            app:layout_constraintStart_toEndOf="@+id/imageView3"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.032" />

        <ScrollView
            android:layout_width="351dp"
            android:layout_height="428dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ajp"
            tools:ignore="SpeakableTextPresentCheck">

            <LinearLayout
                android:layout_width="363dp"
                android:layout_height="418dp"
                android:layout_marginTop="4dp"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ajp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="66dp"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtusu"
                        android:layout_width="78dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/pb"
                        android:gravity="center"
                        android:text="DNI"
                        android:textColor="@color/a1"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/us"
                        android:layout_width="136dp"
                        android:layout_height="55dp"
                        android:layout_marginRight="16dp"
                        android:layout_weight="1"
                        android:background="@drawable/edittext"
                        android:fontFamily="@font/pm"
                        android:gravity="center"
                        android:textColor="@color/a2"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="66dp"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtcorreo"
                        android:layout_width="78dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/pb"
                        android:gravity="center"
                        android:text="Correo"
                        android:textColor="@color/a1"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/mail"
                        android:layout_width="136dp"
                        android:layout_height="55dp"
                        android:layout_marginRight="16dp"
                        android:layout_weight="1"
                        android:background="@drawable/edittext"
                        android:fontFamily="@font/pm"
                        android:gravity="center"
                        android:text=""
                        android:textColor="@color/a2"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="66dp"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtfecha"
                        android:layout_width="78dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/pb"
                        android:gravity="center"
                        android:text="Fecha Nacimiento"
                        android:textColor="@color/a1"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/fecha"
                        android:layout_width="136dp"
                        android:layout_height="55dp"
                        android:layout_marginRight="16dp"
                        android:layout_weight="1"
                        android:background="@drawable/edittext"
                        android:fontFamily="@font/pm"
                        android:gravity="center"
                        android:text=""
                        android:textColor="@color/a2"
                        android:textSize="15sp" />
                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="66dp"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtNueva"
                        android:layout_width="78dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/pb"
                        android:gravity="center"
                        android:text="Contraseña"
                        android:textColor="@color/a1"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/contraN"
                        android:layout_width="136dp"
                        android:layout_height="55dp"
                        android:layout_marginRight="16dp"
                        android:layout_weight="1"
                        android:background="@drawable/edittext"
                        android:drawableLeft="@drawable/candado"
                        android:drawablePadding="8dp"
                        android:hint="@string/contraseña"
                        android:inputType="textPassword" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="66dp"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/idioma"
                        android:layout_width="78dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/pb"
                        android:gravity="center"
                        android:text="Idioma"
                        android:textColor="@color/a1"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spinneridiomaP"
                        android:layout_width="136dp"
                        android:layout_height="55dp"
                        android:layout_marginRight="16dp"
                        android:layout_weight="1"
                        android:background="@drawable/edittext"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.921"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_bias="0.067" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="66dp"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/guar"
                        android:layout_width="136dp"
                        android:layout_height="66dp"
                        android:layout_gravity="center"
                        android:layout_marginLeft="100dp"
                        android:text="@string/guardar"
                        android:textSize="18sp"
                        app:cornerRadius="30dp" />
                </LinearLayout>


            </LinearLayout>
        </ScrollView>


    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>