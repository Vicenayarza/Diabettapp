<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".medico.informes.MaxMinDiarios">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">


        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Maximos y Minimos"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.007" />

        <!-- Botones de rango -->

        <com.github.mikephil.charting.charts.BarChart
            android:id="@+id/barChart"
            android:layout_width="343dp"
            android:layout_height="348dp"
            android:layout_marginTop="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTitulo"
            app:layout_constraintVertical_bias="0.082" />

        <LinearLayout
            android:id="@+id/rangoBotones"
            android:layout_width="369dp"
            android:layout_height="64dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.809"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/barChart"
            app:layout_constraintVertical_bias="0.157">


            <Button
                android:id="@+id/btn7dias"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7 DÍAS"
                android:textSize="12dp" />

            <Button
                android:id="@+id/btn14dias"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="14 DÍAS"
                android:textSize="12dp" />

            <Button
                android:id="@+id/btn30dias"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="30 DÍAS"
                android:textSize="12dp" />

            <Button
                android:id="@+id/btn90dias"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="90 DIAS"
                android:textSize="12dp" />
        </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>